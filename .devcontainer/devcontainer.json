{
  "name": "Cashflow Reborn (Node 22)",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "customizations": {
    "codespaces": {
      "openFiles": ["cashflow-reborn/README.md"]
    },
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss"
      ]
    }
  },
  "updateContentCommand": "cd cashflow-reborn && npm ci",
  "postAttachCommand": {
    "server": "cd cashflow-reborn && npm run dev -- --host"
  },
  "portsAttributes": {
    "5173": {
      "label": "Cashflow Reborn",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [5173]
}
